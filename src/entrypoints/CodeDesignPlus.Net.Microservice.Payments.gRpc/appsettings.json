{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:5000",
        "Protocols": "Http1"
      },
      "Http2": {
        "Url": "http://*:5001",
        "Protocols": "Http2"
      }
    }
  },
  "Core": {
    "AppName": "ms-payments",
    "TypeEntryPoint": "grpc",
    "Version": "v1",
    "Description": "This microservice handles payment processing and transactions.",
    "Business": "CodeDesignPlus",
    "Contact": {
      "Name": "Wilzon Liscano",
      "Email": "wliscano@codedesignplus.com"
    }
  },
  "Security": {
    "ClientId": "ae5bd492-a9a8-4462-9153-a71f960ed269",
    "IncludeErrorDetails": true,
    "ValidateAudience": false,
    "ValidateIssuer": true,
    "ValidateLifetime": true,
    "RequireHttpsMetadata": true,
    "ValidIssuer": "https://codedesignplusdevelopment.b2clogin.com/fb23d3e8-7de7-4554-9d73-78e9904a243f/v2.0/",
    "ValidAudiences": [
      "ae5bd492-a9a8-4462-9153-a71f960ed269"
    ],
    "Applications": []
  },
  "Redis": {
    "Instances": {
      "Core": {
        "ConnectionString": "localhost:6379"
      }
    }
  },
  "RedisCache": {
    "Enable": true,
    "Expiration": "00:05:00"
  },
  "RabbitMQ": {
    "Enable": false,
    "UseQueue": false,
    "Host": "localhost",
    "Port": 5672,
    "UserName": "admin",
    "Password": "password",
    "EnableDiagnostic": true
  },
  "ServiceBus": {
    "Enable": true,
    "UseQueue": false,
    "EnableDiagnostic": true
  },
  "Mongo": {
    "Enable": true,
    "ConnectionString": "mongodb://localhost:27017",
    "Database": "db-ms-payments",
    "Diagnostic": {
      "Enable": false,
      "EnableCommandText": false
    }
  },
  "Logger": {
    "Enable": true,
    "OTelEndpoint": "http://127.0.0.1:4317",
    "Level": "Warning"
  },
  "Observability": {
    "Enable": true,
    "ServerOtel": "http://localhost:4317",
    "Trace": {
      "Enable": true,
      "AspNetCore": true,
      "GrpcClient": true,
      "SqlClient": false,
      "CodeDesignPlusSdk": true,
      "Redis": true,
      "Kafka": false,
      "RabbitMQ": true
    },
    "Metrics": {
      "Enable": true,
      "AspNetCore": true
    }
  },
  "Vault": {
    "Enable": true,
    "Address": "http://127.0.0.1:8200",
    "AppName": "ms-payments",
    "Solution": "security-codedesignplus",
    "Token": "root",
    "Mongo": {
      "Enable": true,
      "TemplateConnectionString": "mongodb://{0}:{1}@localhost:27017"
    },
    "RabbitMQ": {
      "Enable": true
    }
  },
  "GrpcClients": {
    "Notification": "http://ms-notification-grpc.codedesignplus.svc.cluster.local:5001",
    "Location": "http://ms-locations-grpc.kappali.svc.cluster.local:5001"
  },
  "PaymentProviders": {
    "Routing": {
      "CO": "Wompi"
    },
    "Environment": "Sandbox",
    "DefaultReturnUrl": "https://www.kappali.com/payments/return",
    "EventsUrl": "https://www.kappali.com/svc/ms-payments/api/Payment/notify/wompi",
    "CheckoutLifetime": "01:00:00",
    "SecretsCacheLifetime": "00:10:00",
    "ReconciliationMinimumAge": "00:10:00",
    "ReconciliationBatchSize": 200
  },
  "Wompi": {
    "SandboxUrl": "https://sandbox.wompi.co/v1",
    "ProductionUrl": "https://production.wompi.co/v1",
    "CheckoutUrl": "https://checkout.wompi.co/p/",
    "PayoutsSandboxUrl": "https://api.sandbox.payouts.wompi.co/v1",
    "PayoutsProductionUrl": "https://api.payouts.wompi.co/v1",
    "LegalIdTypes": [
      "CC",
      "CE",
      "NIT",
      "PP",
      "TI",
      "DNI",
      "RG",
      "OTHER"
    ],
    "Platform": {
      "PublicKey": "",
      "PrivateKey": "",
      "EventsSecret": "",
      "IntegritySecret": ""
    },
    "Resilience": {
      "Enable": true,
      "MaxRetryAttempts": 3,
      "RetryBaseDelaySeconds": 1.0,
      "RetryMaxDelaySeconds": 10.0,
      "CircuitBreakerFailureRatio": 0.5,
      "CircuitBreakerMinimumThroughput": 10,
      "CircuitBreakerBreakDurationSeconds": 30.0,
      "CircuitBreakerSamplingDurationSeconds": 60.0,
      "TimeoutSeconds": 15.0,
      "RetryOnSoftErrors": true,
      "MaxSoftErrorRetryAttempts": 6,
      "SoftErrorRetryBaseDelaySeconds": 1.0,
      "SoftErrorMaxDelaySeconds": 2.0
    }
  }
}
